    "folds = list(StratifiedGroupKFold(n_splits=10, shuffle=True, random_state=SEED)\n",
    "             .split(pool, pool.label, pool.group_id))\n",
    "pool[\"split\"] = \"train\"\n",
    "pool.loc[folds[0][1], \"split\"] = \"test\"\n",
    "pool.loc[folds[1][1], \"split\"] = \"val\"\n",
    "assert pool.groupby(\"group_id\").split.nunique().max() == 1   # группа целиком в одном сплите\n",
    "\n",
    "stats = pd.crosstab(pool.split, pool.label, margins=True, margins_name=\"all\").loc[[\"train\", \"val\", \"test\", \"all\"]]\n",
    "stats.columns = [\"label_0\", \"label_1\", \"total\"]\n",
    "stats[\"share_1\"] = (stats.label_1 / stats.total).round(3)\n",
    "display(pd.crosstab([pool.split, pool.source], pool.label))\n",
    "stats"
   ]
