   "source": [
    "test = pool[pool.split == \"test\"]\n",
    "def score(df, v):\n",
    "    y = df.label == 1\n",
    "    pred = df.text.map(lambda t: kz_regex.is_profane(t, v))\n",
    "    tp, fp, fn = (pred & y).sum(), (pred & ~y).sum(), (~pred & y).sum()\n",
    "    return f\"P={tp/max(tp+fp,1):.3f}  R={tp/max(tp+fn,1):.3f}  F1={2*tp/max(2*tp+fp+fn,1):.3f}  (n={len(df)}, мат={y.sum()})\"\n",
    "for name, part in [(\"весь test\", test), (\"KazSAnDRA\", test[test.source == \"kazsandra\"]), (\"YouTube\", test[test.source == \"youtube\"])]:\n",
    "    for v in [1, 2]:\n",
    "        print(f\"{name:10s} regex v{v}: {score(part, v)}\")"
   ]
