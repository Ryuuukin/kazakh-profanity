    "def norm_key(t):\n",
    "    t = re.sub(r\"[^\\w\\s]\", \" \", kz_regex.normalize(t))\n",
    "    return re.sub(r\"\\s+\", \" \", t).strip()\n",
    "\n",
    "FOLD = str.maketrans(\"әғқңөұүһіыйёэщц\", \"агкноуухиииеешс\")\n",
    "def fuzzy_key(t):\n",
    "    t = re.sub(r\"[^a-zа-я]\", \"\", t.translate(FOLD))\n",
    "    return re.sub(r\"(.)\\1+\", r\"\\1\", t)\n",
    "\n",
    "def shingles(t, n=5):\n",
    "    t = f\" {t} \"\n",
    "    return {t} if len(t) <= n else {t[i:i + n] for i in range(len(t) - n + 1)}\n",
    "\n",
    "pool[\"key\"] = pool.text.astype(str).map(norm_key)\n",
    "pool = pool[pool.key.str.len() > 0]\n",
    "\n",
    "# точные дубли (если у дублей разные метки — удаляем все)\n",
    "conflict = pool.groupby(\"key\").label.nunique()\n",
    "pool = pool[~pool.key.isin(conflict[conflict > 1].index)]\n",
    "pool = pool.drop_duplicates(\"key\").reset_index(drop=True)\n",
    "\n",
    "# union-find\n",
    "parent = list(range(len(pool)))\n",
    "def find(x):\n",
    "    while parent[x] != x:\n",
    "        parent[x] = parent[parent[x]]; x = parent[x]\n",
    "    return x\n",
    "def union(a, b): parent[find(a)] = find(b)\n",
    "\n",
    "sh = [shingles(t) for t in pool.key]\n",
    "lsh, mhs = MinHashLSH(threshold=0.8, num_perm=128), []\n",
    "for i, s in enumerate(sh):\n",
    "    mh = MinHash(num_perm=128, seed=SEED)\n",
    "    for g in s: mh.update(g.encode(\"utf-8\"))\n",
    "    lsh.insert(str(i), mh); mhs.append(mh)\n",
    "links = 0\n",
    "for i, mh in enumerate(mhs):\n",
    "    for j in map(int, lsh.query(mh)):\n",
    "        if j > i and len(sh[i] & sh[j]) / len(sh[i] | sh[j]) >= 0.8:\n",
    "            union(i, j); links += 1\n",
    "first = {}\n",
    "for i, fk in enumerate(pool.key.map(fuzzy_key)):\n",
    "    if fk in first: union(i, first[fk]); links += 1\n",
    "    else: first[fk] = i\n",
    "by_video = {}\n",
    "for i, v in enumerate(pool.video_id):\n",
    "    if isinstance(v, str):\n",
    "        if v in by_video: union(i, by_video[v])\n",
    "        else: by_video[v] = i\n",
    "\n",
    "pool[\"group_id\"] = [find(i) for i in range(len(pool))]\n",
    "sizes = pool.group_id.value_counts()\n",
    "print(\"записей:\", len(pool), \"| связей почти-дублей:\", links,\n",
    "      \"| групп >1:\", (sizes > 1).sum(), \"| в них записей:\", sizes[sizes > 1].sum())"
   ]
  },
