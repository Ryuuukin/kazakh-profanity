   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "label\n",
      "0    2564\n",
      "1    1659\n",
      "Name: count, dtype: int64\n",
      "label_source\n",
      "regex_negative_llm_spotchecked    2469\n",
      "regex_confirmed_by_llm            1603\n",
      "llm_resolved_weak                   85\n",
      "llm_corrected                       66\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "corr = pd.read_csv(\"llm_corrections.csv\", dtype=str)\n",
    "\n",
    "def apply_labels(p, source, neg_tag):\n",
    "    c = corr[corr.source == source].set_index(\"source_id\")\n",
    "    p = p.copy()\n",
    "    p[\"label\"] = (p.regex_label == 1).astype(int)\n",
    "    p[\"label_source\"] = p.regex_label.map({1: \"regex_confirmed_by_llm\",\n",
    "                                           -1: \"llm_resolved_weak\",\n",
    "                                           0: neg_tag})\n",
    "    m = p.source_id.isin(c.index)\n",
    "    fl = p.loc[m, \"source_id\"].map(c.final_label)\n",
    "    p.loc[m, \"label_source\"] = fl.map(lambda x: \"excluded\" if x == \"EXCLUDE\" else \"llm_corrected\")\n",
    "    p.loc[m & (fl != \"EXCLUDE\"), \"label\"] = fl[fl != \"EXCLUDE\"].astype(int)\n",
    "    return p[p.label_source != \"excluded\"].copy()\n",
    "\n",
    "pool[\"regex_version\"] = 1\n",
    "pool = apply_labels(pool, \"kazsandra\", \"regex_negative_llm_spotchecked\")   # чистые проверены выборочно\n",
    "print(pool.label.value_counts())\n",
    "print(pool.label_source.value_counts())"
   ]
  },
