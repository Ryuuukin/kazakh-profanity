    "UP, LO = \"А-ЯЁӘҒҚҢӨҰҮҺІ\", \"а-яёәғқңөұүһі\"\n",
    "SURNAME = rf\"[{UP}][{LO}]+(?:ов|ова|ев|ева|ёв|ёва|ұлы|улы|қызы|кызы|енко)\"\n",
    "MANUAL_NAMES = [\"Ернар Тұрсын\", \"Сымбат Еркін\", \"Мұрат Әбдлдә\", \"Мади Бекжігіт\", \"Медет Бүркітбай\",\n",
    "                \"Жания Ақылбек\", \"Ұлдана Көшкінбаев\", \"Баян Жусупбекова\", \"Alan Warmer\", \"Aizere love\"]\n",
    "KEEP = {\"Путин\", \"Берлин\", \"Пекин\", \"Кремлин\", \"Ленин\", \"Сталин\", \"Пушкин\", \"Абай\", \"Каспий\"}\n",
    "PII = [\n",
    "    (re.compile(\"|\".join(re.escape(n) for n in MANUAL_NAMES), re.I), \"<NAME>\"),\n",
    "    (re.compile(r\"[\\w.+-]+@[\\w-]+\\.[\\w.]+\"), \"<EMAIL>\"),\n",
    "    (re.compile(r\"https?://\\S+|www\\.\\S+\"), \"<URL>\"),\n",
    "    (re.compile(r\"(?:\\+?7|8)[\\s\\-()]*\\d{3}[\\s\\-()]*\\d{3}[\\s\\-]*\\d{2}[\\s\\-]*\\d{2}\"), \"<PHONE>\"),\n",
    "    (re.compile(r\"\\b\\d{12}\\b\"), \"<ID>\"),\n",
    "    (re.compile(r\"\\b(?:\\d[ -]?){16}\\b\"), \"<CARD>\"),\n",
    "    (re.compile(r\"(?<!\\w)@[\\w.\\-]+\"), \"<USER>\"),\n",
    "    (re.compile(rf\"\\b[{UP}][{LO}]{{2,}}\\s+(?:{SURNAME}|[{UP}][{LO}]+(?:бай|бек|бекова|баев|баева|ев|ов))\\b\"), \"<NAME>\"),\n",
    "    (re.compile(rf\"\\b[{UP}]{{3,}}\\s+[{UP}]{{3,}}(?:ОВА|ОВ|ЕВА|ЕВ|БЕК|БЕКОВА|БАЙ|ҰЛЫ|ҚЫЗЫ)\\b\"), \"<NAME>\"),\n",
    "    (re.compile(rf\"\\b{SURNAME}\\b\"), \"<NAME>\"),\n",
    "]\n",
    "\n",
    "def scrub(text):\n",
    "    text = str(text)\n",
    "    for rx, tok in PII:\n",
    "        if tok == \"<NAME>\":   # не затираем мат, похожий на фамилию\n",
    "            text = rx.sub(lambda m: m.group(0) if (m.group(0) in KEEP or kz_regex.tag(m.group(0))[0] != 0) else tok, text)\n",
    "        else:\n",
    "            text = rx.sub(tok, text)\n",
    "    return text\n",
    "\n",
    "new = pool.text.map(scrub)\n",
    "print(\"изменено текстов:\", (new != pool.text.astype(str)).sum())\n",
    "pool[\"text\"] = new"
   ]
