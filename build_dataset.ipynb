   "source": [
    "yt = pd.read_json(\"comments.jsonl\", lines=True, dtype={\"comment_id\": str, \"parent_id\": str, \"video_id\": str})\n",
    "print(\"комментариев:\", len(yt), \"| видео:\", yt.video_id.nunique())\n",
    "yt = yt[~yt.text.str.contains(r\"[їєґЇЄҐ]\")]                     # явно украинские\n",
    "yt[\"norm\"] = yt.text.astype(str).map(lambda t: re.sub(r\"[^\\w ]\", \"\", kz_regex.normalize(t)).strip())\n",
    "yt = yt[yt.norm.str.len() > 0].drop_duplicates(\"norm\")\n",
    "print(\"после фильтра и точных дублей:\", len(yt))\n",
    "\n",
    "yt = yt.join(kz_regex.tag_series(yt.text, version=2))\n",
    "print(yt.regex_label.value_counts().rename({1: \"мат\", -1: \"спорно\", 0: \"нет\"}))\n",
    "\n",
    "yt_hits = yt[yt.regex_label != 0].assign(sampling=lambda x: x.regex_label.map({1: \"regex_hit\", -1: \"regex_weak\"}))\n",
    "yt_neg = yt[yt.regex_label == 0].sample(700, random_state=SEED).assign(sampling=\"random\")\n",
    "yt_pool = pd.concat([yt_hits, yt_neg]).sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "yt_pool[\"id\"] = [\"yt\" + str(i).zfill(5) for i in range(len(yt_pool))]\n",
    "yt_pool = yt_pool.rename(columns={\"comment_id\": \"source_id\"}).drop(columns=[\"norm\", \"kk_score\", \"parent_id\", \"published\"])\n",
