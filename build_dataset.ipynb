      "до удаления точных дублей: 175158\n",
      "после: 170595\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "sampling\n",
       "regex_hit            1618\n",
       "random               1500\n",
       "random_low_rating    1000\n",
