   ],
   "source": [
    "df[\"norm\"] = df.text.astype(str).map(lambda t: re.sub(r\"[^\\w ]\", \"\", kz_regex.normalize(t)).strip())\n",
    "print(\"до удаления точных дублей:\", len(df))\n",
    "df = df.drop_duplicates(\"norm\")\n",
    "print(\"после:\", len(df))\n",
    "\n",
    "hits = df[df.regex_label != 0].assign(sampling=lambda x: x.regex_label.map({1: \"regex_hit\", -1: \"regex_weak\"}))\n",
    "neg = df[df.regex_label == 0]\n",
    "low = neg[neg.rating <= 2].sample(1000, random_state=SEED).assign(sampling=\"random_low_rating\")\n",
    "rest = neg.drop(low.index).sample(1500, random_state=SEED).assign(sampling=\"random\")\n",
    "\n",
    "pool = pd.concat([hits, low, rest]).sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "pool[\"id\"] = [\"kz\" + str(i).zfill(5) for i in range(len(pool))]\n",
    "pool = pool.drop(columns=\"norm\")\n",
    "pool.sampling.value_counts()"
   ]
  },
